<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FeedRaider.Console</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\FeedRaider.Web\wwwroot\music\*" Link="music\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FeedRaider.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FeedRaider.Engine\FeedRaider.Engine.csproj" />
  </ItemGroup>

</Project>
